# Copy to .env (for docker compose) or server/.env (for npm run dev).

# Required: the 6-digit PIN for the keypad. Changing it signs out every device.
DROP_PIN=123456

# Optional: secret used to sign login tokens. Leave empty to auto-generate one
# and store it in the database.
JWT_SECRET=

# How long a device stays signed in without being used (days).
TOKEN_DAYS=30

# Largest single upload, in MB.
MAX_UPLOAD_MB=500

# Host port for the web UI (docker compose only).
DROP_PORT=80

# Instance name (docker compose only). Prefixes the container names and keeps
# each instance's data volume and network separate. Give every instance its own
# name and DROP_PORT to run several side by side. Lowercase letters, digits, - and _.
# Defaults to the folder name, e.g. drop2-server / drop2-client.
# COMPOSE_PROJECT_NAME=drop
